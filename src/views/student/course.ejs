<div class="eyebrow">
  <span>Curso</span>
  <span class="meta"><%= stats.total %> lecciones · <%= stats.percent %>% completado</span>
</div>

<h1><%= course.title %></h1>
<p class="lede"><%= course.description %></p>

<h2>Módulos</h2>

<% if (tree.length) { %>
<% const QICON = { preparing: '✎', pending: '○', running: '◐', failed: '✗', approved: '✓' };
   const QWORD = { preparing: 'En preparación', pending: 'Pendiente', running: 'En curso', failed: 'Suspendido', approved: 'Aprobado' }; %>
<div class="table-scroll"><table class="dense">
  <thead>
    <tr><th>Módulo</th><th>Lecciones</th><th>Progreso</th><th>Quiz</th></tr>
  </thead>
  <tbody>
    <% tree.forEach((mod) => { %>
    <tr>
      <td><%= mod.title %></td>
      <td><%= mod.lessons.length %></td>
      <td><%= mod.lessons.filter((l) => l.done).length %> / <%= mod.lessons.length %></td>
      <td>
        <% if (mod.quiz) { %>
        <a class="qstate qstate-<%= mod.quiz.state %>" href="/c/<%= course.slug %>/quiz/<%= mod.quiz.id %>">
          <span aria-hidden="true"><%= QICON[mod.quiz.state] %></span>
          <span class="sr"><%= QWORD[mod.quiz.state] %>.</span>
          <%= mod.quiz.title %>
        </a>
        <% } else { %>—<% } %>
      </td>
    </tr>
    <% }) %>
  </tbody>
</table></div>
<% } else { %>
<div class="defbox">
  <b>Sin contenido</b>
  Este curso aún no tiene módulos.
  <% if (user && user.role === 'admin') { %>(Añádelos desde el panel de administración.)<% } %>
</div>
<% } %>

<% if (nextLesson) { %>
<div class="defbox">
  <b>Continuar</b>
  <a href="/c/<%= course.slug %>/l/<%= nextLesson.id %>"><%= nextLesson.title %></a>
</div>
<% } %>
