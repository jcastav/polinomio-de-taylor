<div class="eyebrow">
  <span><%= module.title %> · Lección <%= lesson.position %></span>
  <span class="meta"><%= stats.done %> / <%= stats.total %> completadas</span>
</div>

<h1><%= lesson.title %></h1>

<div class="lesson-body">
  <%- lesson.html %>
</div>

<% if (isLastLesson && moduleInfo && moduleInfo.quiz) { %>
<%
  const pendingLessons = moduleInfo.lessonsTotal - moduleInfo.lessonsDone;
  const unlocked = pendingLessons === 0;
%>
<section class="quiz-cta">
  <% if (unlocked) { %>
  <a class="btn btn-positive btn-big" href="/c/<%= course.slug %>/quiz/<%= moduleInfo.quiz.id %>">
    Avanzar al quiz del módulo →
  </a>
  <% } else { %>
  <button class="btn btn-positive btn-big" type="button" disabled aria-disabled="true">
    Avanzar al quiz del módulo →
  </button>
  <p class="cta-hint">Completa las <%= pendingLessons %> lecciones del módulo para desbloquearlo</p>
  <% } %>
</section>
<% } %>

<div class="lesson-foot">
  <% if (prev) { %>
  <a class="btn" href="/c/<%= course.slug %>/l/<%= prev.id %>">← Lección anterior</a>
  <% } %>

  <% if (!completed) { %>
  <form method="post" action="/c/<%= course.slug %>/l/<%= lesson.id %>/complete">
    <button class="btn btn-positive" type="submit">Marcar como completada</button>
  </form>
  <% } else { %>
  <span class="lesson-done">✓ Completada</span>
  <% } %>

  <% if (next) { %>
  <a class="btn btn-dark" href="/c/<%= course.slug %>/l/<%= next.id %>">Siguiente lección</a>
  <% } else { %>
  <a class="btn" href="/c/<%= course.slug %>">Volver al curso</a>
  <% } %>
</div>
