<div class="eyebrow">
  <span>Acceso</span>
  <span class="meta">Aula · v1</span>
</div>

<h1>Entrar</h1>
<p class="lede">
  El administrador entra con su correo; los estudiantes, con su nombre.
</p>

<% if (expiredNotice) { %>
  <div class="defbox" role="status"><b>Sesión</b><%= expiredNotice %></div>
<% } %>

<% if (errors._) { %>
  <div class="defbox"><b>Error</b><%= errors._ %></div>
<% } %>

<form class="authform" method="post" action="/login">
  <% if (returnTo) { %><input type="hidden" name="returnTo" value="<%= returnTo %>"><% } %>
  <label for="identity">Correo o nombre</label>
  <input id="identity" name="identity" type="text" autocomplete="username"
         maxlength="200" autofocus value="<%= values.identity || '' %>">
  <% if (errors.identity) { %><span class="field-error"><%= errors.identity %></span><% } %>

  <label for="password">Contraseña</label>
  <input id="password" name="password" type="password"
         autocomplete="current-password" maxlength="200">
  <% if (errors.password) { %><span class="field-error"><%= errors.password %></span><% } %>

  <button class="btn btn-dark" type="submit">Entrar</button>
</form>

<p class="auth-alt">¿No tienes cuenta? <a href="/register">Regístrate</a></p>
