<div class="eyebrow">
  <span>Registro</span>
  <span class="meta">Aula · v1</span>
</div>

<h1>Crear cuenta</h1>
<p class="lede">
  Tu nombre será tu identificador para entrar. Solo se registran estudiantes.
</p>

<% if (errors._) { %>
  <div class="defbox"><b>Error</b><%= errors._ %></div>
<% } %>

<form class="authform" method="post" action="/register">
  <label for="name">Nombre</label>
  <input id="name" name="name" type="text" autocomplete="username"
         maxlength="60" autofocus value="<%= values.name || '' %>">
  <% if (errors.name) { %><span class="field-error"><%= errors.name %></span><% } %>

  <label for="password">Contraseña</label>
  <input id="password" name="password" type="password"
         autocomplete="new-password" maxlength="200">
  <% if (errors.password) { %><span class="field-error"><%= errors.password %></span><% } %>
  <span class="field-hint">Mínimo 8 caracteres.</span>

  <button class="btn btn-dark" type="submit">Crear cuenta</button>
</form>

<p class="auth-alt">¿Ya tienes cuenta? <a href="/login">Entra</a></p>
