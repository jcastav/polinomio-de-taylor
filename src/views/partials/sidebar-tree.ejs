<div class="side-head">Contenido del curso</div>
<% const QICON = { preparing: '✎', pending: '○', running: '◐', failed: '✗', approved: '✓' };
   const QWORD = { preparing: 'En preparación', pending: 'Pendiente', running: 'En curso', failed: 'Suspendido', approved: 'Aprobado' }; %>

<% if (typeof tree !== 'undefined' && tree && tree.length) { %>
<div class="side-progress">
  <div class="bar"><i style="width:<%= stats.percent %>%"></i></div>
  <div class="txt"><span>Progreso</span><span><%= stats.done %> / <%= stats.total %></span></div>
</div>

<% tree.forEach((mod) => { %>
<div class="mod">
  <button type="button" aria-expanded="true" aria-controls="modlist-<%= mod.id %>"><%= mod.title %> <span class="caret">▼</span></button>
  <ul id="modlist-<%= mod.id %>">
    <% mod.lessons.forEach((l) => { %>
    <% const esActual = currentLessonId === l.id; %>
    <li>
      <a href="/c/<%= course.slug %>/l/<%= l.id %>"
         class="<%= l.done ? 'done ' : '' %><%= esActual ? 'current' : '' %>">
        <% if (l.done) { %><span class="st">✓</span><% } else if (!esActual) { %><span class="st">○</span><% } %>
        <%= l.title %>
      </a>
    </li>
    <% }) %>
    <% if (mod.quiz) { %>
    <% const qz = mod.quiz; %>
    <li>
      <% if (qz.locked) { %>
      <span class="qstate qstate-locked" aria-disabled="true"
            title="Completa las lecciones del módulo para acceder al quiz">
        <span class="st" aria-hidden="true">🔒</span>
        <span class="sr">Bloqueado.</span>
        <%= qz.title %>
        <span class="tag"><%= qz.kind === 'exam' ? '[EXAMEN]' : '[QUIZ]' %></span>
      </span>
      <% } else { %>
      <a href="/c/<%= course.slug %>/quiz/<%= qz.id %>"
         class="qstate qstate-<%= qz.state %><%= qz.state === 'approved' ? ' done' : '' %>">
        <span class="st" aria-hidden="true"><%= QICON[qz.state] %></span>
        <span class="sr"><%= QWORD[qz.state] %>.</span>
        <%= qz.title %>
        <span class="tag"><%= qz.kind === 'exam' ? '[EXAMEN]' : '[QUIZ]' %></span>
      </a>
      <% } %>
    </li>
    <% } %>
  </ul>
</div>
<% }) %>

<% } else { %>
<div class="side-progress">
  <div class="bar"><i style="width:0%"></i></div>
  <div class="txt"><span>Progreso</span><span>0 / 0</span></div>
</div>
<% } %>

<% if (typeof exam !== 'undefined' && exam) { %>
<div class="mod">
  <button type="button" aria-expanded="true" aria-controls="modlist-exam">Examen final <span class="caret">▼</span></button>
  <ul id="modlist-exam">
    <li>
      <% if (exam.locked) { %>
      <span class="qstate qstate-locked" aria-disabled="true"
            title="Aprueba todos los quizzes del módulo para acceder al examen">
        <span class="st" aria-hidden="true">🔒</span>
        <span class="sr">Bloqueado.</span>
        <%= exam.title %>
        <span class="tag">[EXAMEN]</span>
      </span>
      <% } else { %>
      <a href="/c/<%= course.slug %>/exam" class="qstate qstate-<%= exam.state %><%= exam.state === 'approved' ? ' done' : '' %>">
        <span class="st" aria-hidden="true"><%= QICON[exam.state] %></span>
        <span class="sr"><%= exam.state === 'approved' ? 'Examen completado' : QWORD[exam.state] %>.</span>
        <%= exam.title %>
        <span class="tag">[EXAMEN]</span>
      </a>
      <% } %>
    </li>
  </ul>
</div>
<% } %>
