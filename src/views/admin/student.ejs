<%- include('../partials/admin-nav', { nav: 'students' }) %>
<%- include('../partials/saved-flash') %>

<div class="eyebrow">
  <span>Estudiante</span>
  <span class="meta"><%= student.email || 'sin correo' %></span>
</div>

<h1><%= student.name %></h1>

<h2>Cambiar contraseña</h2>

<% if (pwFlash) { %>
<p class="saved-flash" role="status">Contraseña actualizada. Guárdala ahora — no se volverá a mostrar: <code><%= pwFlash %></code></p>
<% } %>

<form class="panel-box" method="post" action="/admin/students/<%= student.id %>/password">
  <div class="form-row">
    <label for="new-pass">Nueva contraseña (mínimo 8)</label>
    <input id="new-pass" type="password" name="password" maxlength="200" required
           autocomplete="new-password">
    <% if (errors._) { %><span class="field-error"><%= errors._ %></span><% } %>
  </div>
  <button class="btn btn-dark" type="submit">Cambiar contraseña</button>
</form>

<div class="stat-cards">
  <div class="panel-box stat-card"><span>Lecciones vistas</span><b><%= lessonsDone %></b></div>
  <div class="panel-box stat-card"><span>Intentos</span><b><%= attempts.length %></b></div>
</div>

<h2>Intentos</h2>

<% if (attempts.length) { %>
<div class="table-scroll"><table class="dense">
  <thead>
    <tr><th>Fecha</th><th>Quiz</th><th>Nota</th><th>Estado</th><th></th></tr>
  </thead>
  <tbody>
    <% attempts.forEach((a) => { %>
    <tr>
      <td><%= a.fecha %></td>
      <td><%= a.quizTitle %></td>
      <td><%= a.status === 'in_progress' ? '—' : `${a.score} / ${a.max_score}` %></td>
      <td><%= a.status === 'in_progress' ? 'En curso' : (a.passed ? 'Aprobado' : 'Suspendido') %></td>
      <td><a class="btn btn-sm" href="/admin/attempts/<%= a.id %>">Revisar</a></td>
    </tr>
    <% }) %>
  </tbody>
</table></div>
<% } else { %>
<div class="defbox"><b>Sin intentos</b>Este estudiante aún no ha enviado quizzes.</div>
<% } %>

<div class="result-actions">
  <a class="btn" href="/admin/students">Volver a estudiantes</a>
</div>
