# Supabase (proyecto → Settings → API)
SUPABASE_URL=https://TU-PROYECTO.supabase.co
SUPABASE_SERVICE_ROLE_KEY=TU-SERVICE-ROLE-KEY

# Sesiones (cadena larga y aleatoria)
SESSION_SECRET=cambia-esta-cadena-por-una-larga-y-aleatoria

# Puerto (Render lo inyecta; local usa 3000)
PORT=3000

# Solo para `npm run seed` — admin inicial
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=cambia-esta-password-min-8
ADMIN_NAME=Admin
